# ============================================================
# WeatherGPT MVP - environment variables
# Copy to .env  ( Windows: copy .env.example .env )
# Values left blank fall back to the defaults in backend/config.py
# ============================================================

# --- LLM (Groq). Phase 4: an EXPLANATION layer only, never a source of data. ---
# Get a key: https://console.groq.com/keys   (free tier, instant)
# Empty key is a supported state: the backend answers from the evidence deterministically and the
# trace records llm_status="no_key". Nothing about availability depends on this key.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
# false => never call the LLM (the deterministic grounded answer is used for every request)
LLM_ENABLED=true
LLM_CHAT_COMPLETIONS_PATH=/chat/completions
# The model gets ONE message (the evidence dump) and must answer in under this many tokens.
LLM_MAX_TOKENS=500
# 0.0: the explanation must be reproducible; a "creative" weather answer is a wrong one.
LLM_TEMPERATURE=0.0
# Ask for response_format={"type":"json_object"} (Groq supports it on the model above).
LLM_JSON_MODE=true
# 30s: a slow model must not hold the weather answer hostage; on timeout we fall back.
LLM_TIMEOUT_S=30
# first answer + exactly ONE regeneration carrying the verifier's complaints, then fallback
LLM_MAX_ATTEMPTS=2
# Demo switches — they exist to PROVE THE GUARD FIRES, never to fake a model success.
# SIMULATE_LLM_FAILURE  : behaves like api.groq.com being dead -> upstream_error -> fallback answer
# SIMULATE_LLM_HALLUCINATION : injects a number absent from the evidence -> grounding must reject it
SIMULATE_LLM_FAILURE=false
SIMULATE_LLM_HALLUCINATION=false

# --- Weather provider (Phase 5A: provider registry) ---
# Registered providers (see backend/services/providers/):
#   open-meteo  -> CURRENT/LIVE (implemented). Free, no key.
#   imd / gfs / wrf -> ARCHITECTURE-READY STUBS only. They are discoverable in the registry and
#                      /health, but fetch() raises the standard UpstreamError (-> honest abstain/
#                      fallback); no live data is wired and none is faked.
WEATHER_PROVIDER=open-meteo
OPEN_METEO_FORECAST_URL=https://api.open-meteo.com/v1/forecast
OPEN_METEO_ARCHIVE_URL=https://archive-api.open-meteo.com/v1/archive
OPEN_METEO_GEOCODING_URL=https://geocoding-api.open-meteo.com/v1/search
# Optional single Open-Meteo NWP model (forecast `models=` param). Leave EMPTY for Open-Meteo's
# "best_match". This is NOT multi-model/ensemble retrieval (out of scope) — only one model is
# requested and recorded on WeatherBundle.model. Historical/archive calls ignore it (reanalysis).
# e.g. OPEN_METEO_MODEL=gfs_seamless   or  OPEN_METEO_MODEL=ecmwf_ifs025
OPEN_METEO_MODEL=

# --- Geocoding behaviour ---
# Bias answers to India ("IN"). Set EMPTY to allow any country (needed for the
# Springfield ambiguity demo if you want global matches).
GEO_COUNTRY_BIAS=IN
# Extra candidate rows fetched from the geocoder, used to detect ambiguity.
GEO_MAX_RESULTS=10
# A same-named place competes for "ambiguous" only if it is a real settlement (population
# above this, or an administrative seat). Stops pointless clarifications for "Nagpur".
AMBIGUITY_MIN_POP=100000
# Fallback gazetteer for towns the primary one misses: none | nominatim
GEO_FALLBACK=nominatim
NOMINATIM_USER_AGENT=WeatherGPT-MVP/0.1 (SIH26068 student prototype)

# --- Official disaster alerts: NDMA SACHET (Phase 2) ---
SACHET_ENABLED=true
SACHET_RSS_BASE=https://sachet.ndma.gov.in/cap_public_website/rss
SACHET_CAP_URL=https://sachet.ndma.gov.in/cap_public_website/FetchXMLFile?identifier={id}
SACHET_USER_AGENT=WeatherGPT-MVP/0.1 (SIH26068 student prototype)
# Poll politely: feeds are cached in-memory for this many seconds (no Redis).
ALERT_CACHE_TTL_S=300
# Alert items older than this are treated as stale (the India feed still serves 1000 h old items).
ALERT_MAX_AGE_H=24
# CAP detail bodies fetched per query (each is one HTTP GET). 6-10 keeps the demo fast.
ALERT_DETAIL_LIMIT=8
ALERT_DETAIL_CONCURRENCY=4
# Also read the national feed (true) in addition to the state feed.
ALERT_INCLUDE_INDIA_FEED=true
# Deterministic offline rehearsal/demo of the alert path using REAL recorded SACHET files.
# Mode is reported as "fixture_replay" in the evidence, never as live.
ALERT_FIXTURE_RSS=
ALERT_FIXTURE_CAP_DIR=

# --- Validation / pipeline tuning (seconds) ---
HTTP_TIMEOUT_S=15
WEATHER_MAX_STALENESS_MIN=90
ALERT_CACHE_TTL_S=300
ALERT_MAX_AGE_H=24

# --- Demo failure simulation (Phase 5). Keep off normally. ---
SIMULATE_WEATHER_FAILURE=false
SIMULATE_STALE_DATA=false
SIMULATE_LATENCY_MS=0
# Show the "alert source unavailable" state without waiting for a real outage:
SIMULATE_ALERT_FAILURE=false
